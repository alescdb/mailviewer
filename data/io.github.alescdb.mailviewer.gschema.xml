<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.alescdb.mailviewer" path="/io/github/alescdb/mailviewer/">
    <key name="width" type="i">
      <default>800</default>
    </key>
    <key name="height" type="i">
      <default>600</default>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
    </key>
    <key name="is-fullscreen" type="b">
      <default>false</default>
    </key>
    <key name="zoom" type="d">
      <default>1.0</default>
      <range min="0.3" max="5.0"/>
    </key>
    <key name="show-file-name" type="b">
      <default>true</default>
    </key>
    <key name="force-css" type="b">
      <default>false</default>
    </key>
  </schema>
</schemalist>
